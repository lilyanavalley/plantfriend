# ============================================================================
# hydrolevel – optional build overrides
# ============================================================================
# The canonical build configuration is now in `device.toml`.
#
# `.env` remains supported ONLY for optional overrides (primarily TLS path and
# OTA behavior). Values here can still be convenient for local experiments.
#
# Copy this file to `.env` only if you need overrides.
# ============================================================================

# ------------------------------------------------------------------------------
# TLS / certificate-based authentication (optional)
# ------------------------------------------------------------------------------
# Paths override `mqtt.tls.*` in `device.toml` when set.
# Paths are resolved relative to this firmware crate when not absolute.
#
# CA certificate (PEM or DER).
PLANTFRIEND_MQTT_CA_CERT_PATH=

# Client certificate + private key for mTLS (optional).
# Both must be set together or both left blank.
PLANTFRIEND_MQTT_CLIENT_CERT_PATH=
PLANTFRIEND_MQTT_CLIENT_KEY_PATH=

# ------------------------------------------------------------------------------
# Logging (optional)
# ------------------------------------------------------------------------------
# ESP-IDF log level: NONE, ERROR, WARN, INFO, DEBUG, VERBOSE
PLANTFRIEND_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# OTA updates (optional)
# ------------------------------------------------------------------------------
# Leave empty to disable OTA checks at startup.
PLANTFRIEND_OTA_URL=
# Set true only when you intend to apply the image from PLANTFRIEND_OTA_URL.
PLANTFRIEND_OTA_AUTO_APPLY=false

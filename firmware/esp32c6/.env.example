# ==============================================================================
# hydrolevel – user-configurable environment variables
# ==============================================================================
# Copy this file to .env and fill in your values.
# The .env file is loaded at BUILD TIME by build.rs and its values are baked
# into the firmware as compile-time constants.  Never commit .env to version
# control – it is listed in .gitignore.
#
# All variables below are REQUIRED unless marked optional.
# ==============================================================================

# ------------------------------------------------------------------------------
# Optional bootstrap Wi-Fi credentials
# ------------------------------------------------------------------------------
# Leave empty for AP-based first-time pairing through the setup portal.
# If set, these credentials are attempted once when no paired credentials exist,
# and on success they are persisted into NVS automatically.
PLANTFRIEND_WIFI_BOOTSTRAP_SSID=
PLANTFRIEND_WIFI_BOOTSTRAP_PASSWORD=

# Pairing AP configuration.
# If AP SSID is empty, the firmware uses PLANTFRIEND_HA_DEVICE_ID.
PLANTFRIEND_PAIRING_AP_SSID=
# Wi-Fi channel used for setup AP mode (1-13, region-dependent).
PLANTFRIEND_PAIRING_AP_CHANNEL=1
# Maximum clients that can connect to setup AP simultaneously.
PLANTFRIEND_PAIRING_AP_MAX_CONNECTIONS=4

# ------------------------------------------------------------------------------
# MQTT broker connection
# ------------------------------------------------------------------------------
# Broker URI.  Supported schemes:
#   mqtt://   – plain MQTT 3.1.1 (no TLS, no auth)
#   mqtts://  – MQTT 3.1.1 over TLS
#   mqtt5://  – plain MQTT 5.0
#   mqtt5s:// – MQTT 5.0 over TLS
PLANTFRIEND_MQTT_BROKER_URI=mqtt://homeassistant.local:1883

# Credentials for password-based broker authentication (optional).
# Leave blank if the broker is unauthenticated.
PLANTFRIEND_MQTT_USERNAME=
PLANTFRIEND_MQTT_PASSWORD=

# Client identifier sent to the broker (must be unique per device).
PLANTFRIEND_MQTT_CLIENT_ID=hydrolevel-01

# ------------------------------------------------------------------------------
# TLS / certificate-based authentication (optional)
# ------------------------------------------------------------------------------
# Paths are resolved relative to the project root at build time and the file
# contents are embedded into the firmware binary.
#
# CA certificate (PEM) – required when using mqtts:// or mqtt5s://.
# Leave blank to use the system trust store (if available on your build).
PLANTFRIEND_MQTT_CA_CERT_PATH=

# Client certificate + private key for mTLS (optional).
# Both must be set together or both left blank.
PLANTFRIEND_MQTT_CLIENT_CERT_PATH=
PLANTFRIEND_MQTT_CLIENT_KEY_PATH=

# ------------------------------------------------------------------------------
# Home Assistant / MQTT topics
# ------------------------------------------------------------------------------
# Top-level HA discovery prefix (must match HA's "Discovery prefix" setting).
PLANTFRIEND_HA_DISCOVERY_PREFIX=homeassistant

# Unique device identifier used in all HA discovery topics and device metadata.
# Must be globally unique across your HA instance.
PLANTFRIEND_HA_DEVICE_ID=PLANTFRIEND_01

# Human-readable device name shown in HA.
PLANTFRIEND_HA_DEVICE_NAME=Hydrolevel Sensor

# State topic published to on every sensor change.
# Default: hydrolevel/<device_id>/state
PLANTFRIEND_MQTT_STATE_TOPIC=hydrolevel/PLANTFRIEND_01/state

# Availability topic (published "online"/"offline" with LWT).
# Default: hydrolevel/<device_id>/availability
PLANTFRIEND_MQTT_AVAILABILITY_TOPIC=hydrolevel/PLANTFRIEND_01/availability

# ------------------------------------------------------------------------------
# Sensor hardware
# ------------------------------------------------------------------------------
# GPIO pin number connected to the sensor OUTPUT pin.
# The XKC-Y25-NPN capacitive sensor has an NPN open-collector output:
#   - HIGH (3.3 V pulled up) = no liquid detected
#   - LOW  (pulled to GND)  = liquid detected
# Adjust SENSOR_ACTIVE_HIGH to "true" if your wiring or sensor variant
# produces HIGH when liquid is present instead.
PLANTFRIEND_SENSOR_GPIO=4
PLANTFRIEND_SENSOR_ACTIVE_HIGH=false

# Debounce time in milliseconds – state changes shorter than this are ignored.
PLANTFRIEND_SENSOR_DEBOUNCE_MS=200

# How often (ms) to publish the sensor state even when unchanged (heartbeat).
# Set to 0 to disable periodic publishing (publish on change only).
PLANTFRIEND_PUBLISH_INTERVAL_MS=30000

# ------------------------------------------------------------------------------
# Logging (optional)
# ------------------------------------------------------------------------------
# ESP-IDF log level: NONE, ERROR, WARN, INFO, DEBUG, VERBOSE
PLANTFRIEND_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# OTA updates (optional)
# ------------------------------------------------------------------------------
# If set, the firmware downloads this image on boot and applies it to the next
# OTA slot, then reboots into the new version.
# Leave empty to disable auto-OTA checks at startup.
PLANTFRIEND_OTA_URL=
# Safety switch for OTA-on-boot behavior. Set true only when you intend to
# apply the image from PLANTFRIEND_OTA_URL once (then set back to false).
PLANTFRIEND_OTA_AUTO_APPLY=false
